generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  type        String
  payload     Json
  status      String
  priority    Int
  createdAt   DateTime @default(now())
  processedAt DateTime?
  result      Json?
}
